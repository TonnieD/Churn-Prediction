{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "experimentalServices": [
        {
            "name": "frontend",
            "root": "frontend",
            "routePrefix": "/",
            "framework": "nextjs"
        },
        {
            "name": "backend",
            "root": "backend",
            "routePrefix": "/_/backend",
            "framework": "fastapi",
            "entrypoint": "app/main.py"
        }
    ]
}